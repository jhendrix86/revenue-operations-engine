# Payment Processing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/revenue

# Redis
REDIS_URL=redis://localhost:6379

# Tax
TAX_API_KEY=

# Currency
DEFAULT_CURRENCY=USD

# Invoice Settings
INVOICE_DAYS_UNTIL_DUE=30
INVOICE_PREFIX=INV-

# Dunning Settings
DUNNING_MAX_ATTEMPTS=3

# Email
SENDGRID_API_KEY=
FROM_EMAIL=billing@company.com

# baselayer income_engine (real billing/subscriptions/payments logic)
BASELAYER_URL=http://localhost:8000
BASELAYER_SERVICE_EMAIL=
BASELAYER_SERVICE_PASSWORD=

# Unkey (API key verification + rate limiting - leave UNKEY_ROOT_KEY blank to
# fail open / allow all requests until a real Unkey workspace is set up)
UNKEY_ROOT_KEY=
UNKEY_API_ID=
UNKEY_BASE_URL=https://api.unkey.com/v2

# Application
DEBUG=false

# Integration
GLOBAL_STATE_MANAGER_URL=http://localhost:8035
GOVERNANCE_ENGINE_URL=http://localhost:8033
KNOWLEDGE_GRAPH_URL=http://localhost:8034
